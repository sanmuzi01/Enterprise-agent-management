{
  "name": "knowledge-assistant",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "frontend:dev": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "frontend:build": "npm --prefix frontend run build",
    "backend:dev": ".venv\\Scripts\\python.exe -m uvicorn FasdtApi.main:app --reload --host 127.0.0.1 --port 8011",
    "backend:worker": ".venv\\Scripts\\python.exe -m service.background_worker",
    "seed:demo": ".venv\\Scripts\\python.exe scripts\\seed_demo.py",
    "backup": ".venv\\Scripts\\python.exe scripts\\backup.py",
    "db:current": ".venv\\Scripts\\python.exe -m alembic current",
    "db:migrate": ".venv\\Scripts\\python.exe -m alembic upgrade head",
    "db:stamp": ".venv\\Scripts\\python.exe -m alembic stamp head",
    "crawl:check": ".venv\\Scripts\\python.exe scripts\\crawl_check.py",
    "load:test": ".venv\\Scripts\\python.exe scripts\\load_test.py",
    "test:unit": ".venv\\Scripts\\python.exe -m unittest discover -s tests -p \"test_*.py\"",
    "test:coverage": ".venv\\Scripts\\python.exe -m coverage run -m unittest discover -s tests -p \"test_*.py\" && .venv\\Scripts\\python.exe -m coverage report --fail-under=65 && .venv\\Scripts\\python.exe -m coverage xml",
    "lint:py": ".venv\\Scripts\\python.exe -m ruff check FasdtApi service models utils scripts tests",
    "audit:py": ".venv\\Scripts\\python.exe -m pip_audit -r requirements.txt",
    "audit:npm": "npm --prefix frontend audit --omit=dev --audit-level=high",
    "release:check": ".venv\\Scripts\\python.exe scripts\\release_check.py"
  }
}
