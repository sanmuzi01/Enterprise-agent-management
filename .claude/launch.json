{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "FasdtApi.main:app", "--host", "127.0.0.1", "--port", "8011"],
      "port": 8011
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "frontend:dev"],
      "port": 5173
    },
    {
      "name": "frontend-e2e",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "backend-alt",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "FasdtApi.main:app", "--host", "127.0.0.1", "--port", "8012"],
      "port": 8012
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_API_PROXY_TARGET=http://127.0.0.1:8012&& npm --prefix frontend run dev -- --host 127.0.0.1 --port 5175 --strictPort"],
      "port": 5175
    }
  ]
}
