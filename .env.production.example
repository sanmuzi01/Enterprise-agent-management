# ============================================================================
# 生产环境配置模板 —— 【直接在服务器上跑】（systemd / 直接起进程）：MySQL、Redis、业务服务都在本机，用 127.0.0.1。
# 用 docker-compose.prod.yml 部署请改用 .env.production.docker.example（里面的主机名是容器服务名 db / redis / enterprise-hub，
# 在容器里 127.0.0.1 指的是容器自己，写错会连不上）。两份模板的变量一一对应，只有下面几项主机地址不同
# （tests/test_env_templates.py 会核对）。
# ============================================================================
# db 容器自己的管理密码（建账号、跑迁移这类操作用），只有你手动跑迁移或直接
# 用 root 连库排障时才会用到——api/worker/enterprise-hub 平时处理业务请求完全
# 不读这个变量，泄露风险跟这几个长期在线的进程完全隔离。必须跟下面 DB_PASSWORD/
# ENTERPRISE_DB_PASSWORD 不一样，见 docker-compose.prod.yml 顶部注释。
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# 业务运行时账号（api/worker 用）：只被授予 SELECT/INSERT/UPDATE/DELETE，没有
# CREATE/ALTER/DROP/GRANT，建号脚本见 deploy/mysql-init/03-create-app-runtime-users.sh。
# 一个被攻破的应用进程改不了表结构、建不了新账号——真正需要 DDL 的迁移单独用
# MYSQL_ROOT_PASSWORD 跑（见 docker-compose.prod.yml 顶部启动步骤）。
DB_USER=app_runtime
APP_ENV=production
DB_PASSWORD=change-me-strong-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agent_sql
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
# 异步数据库读取链路使用 asyncmy 驱动，连接池参数复用上面的 DB_POOL_*。
# 生产安装 requirements.txt 后自动启用；本地未安装时会回退同步数据库链路。

# 关掉进程内自动建表/幂等迁移（models/init_db.py::bootstrap_database）——表结构
# 完全交给 `alembic upgrade head` 管，业务运行时账号（上面的 DB_USER）也就永远
# 不需要 DDL 权限。本地开发默认开着（方便直接跑起来），生产必须关掉，否则
# DB_USER 要么建表失败要么必须保留 DDL 权限，两者都不对。
DB_AUTO_BOOTSTRAP=0

# 审计事件（audit_event 表）写入专用账号：只被授予 INSERT/SELECT，没有 UPDATE/DELETE，
# 防止一个被攻破的应用进程篡改或抹掉自己写过的审计记录（建号脚本见
# deploy/mysql-init/02-create-audit-user.sh，说明见 docs/enterprise-rbac-plan.md 第21节）。
# 留空则退回 DB_USER/DB_PASSWORD——仅适合本地开发，生产必须单独设置。
AUDIT_DB_USER=audit_writer
AUDIT_DB_PASSWORD=change-me-strong-audit-password

# uvicorn --workers 数量；会放大数据库连接池总量，调大前确认 MySQL max_connections。
API_WORKERS=2
ADMIN_USERNAME=admin
# 必须显式设置，且不能是弱密码（139218/admin/123456 等会被启动校验拦截）。
ADMIN_PASSWORD=change-me-strong-admin-password
# 仅在需要找回丢失的管理员密码时临时设为 true，配合 ADMIN_PASSWORD 覆盖已有密码，用完改回 false。
ADMIN_PASSWORD_RESET=false

TRUSTED_HOSTS=your-domain.com,www.your-domain.com
CORS_ALLOW_ORIGINS=https://your-domain.com,https://www.your-domain.com
MAX_REQUEST_BODY_BYTES=52428800
ENABLE_HSTS=1

# 登录令牌放在 HttpOnly Cookie 里（页面脚本读不到，见 service/session_cookie.py）。
# 生产必须带 Secure（只在 https 上发送）：设成 0 会被启动校验拒绝。SameSite 可改成 strict。
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=lax

# 知识库上传：流式写临时文件，不占内存（见 utils/upload_limits.py）。单个文件 / 一次请求累计（默认与 Nginx 的 client_max_body_size 50m 一致）/
# 批量上传的文件个数 / 同一个用户同时进行的上传个数。超限直接 413 / 400 / 429。
KNOWLEDGE_UPLOAD_MAX_BYTES=52428800
KNOWLEDGE_UPLOAD_REQUEST_MAX_BYTES=52428800
KNOWLEDGE_UPLOAD_MAX_FILES=20
USER_MAX_CONCURRENT_UPLOADS=3

# 浏览器登录（POST /user/login）只下发 HttpOnly Cookie，响应体里没有 JWT。
# 脚本 / CLI / 集成需要 Bearer 令牌时走 POST /auth/token（单独限流和审计）；生产默认关闭，需要时才设为 1。
AUTH_TOKEN_ENDPOINT_ENABLED=0
TOKEN_IP_RATE_LIMIT=10
TOKEN_USER_RATE_LIMIT=5

# 就绪探针 /ready（也是 /health）：数据库不可用返回 503；Redis 不可用默认只算“降级”（有告警），设成 1 则 Redis 不可用也返回 503。
READY_REQUIRE_REDIS=0
# 数据库网络“半通不通”（端口能连上、握手没有回应）时，连接必须在有限时间内结束，不能把线程一直卡住：
# DB_CONNECT_TIMEOUT 是 TCP 连接超时；DB_READ_TIMEOUT 是每次读（等握手 / 等查询结果）的兜底超时，要大于 MySQL 的 innodb_lock_wait_timeout（默认 50 秒）。
# 就绪探针用独立的短连接，整体不超过 READY_TIMEOUT_SECONDS。
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=60
READY_TIMEOUT_SECONDS=3
# Redis 不可用时的降级策略：
#   登录 / 短信 / 注册 / 找回密码：open（各进程独立额度）/ strict（额度按 API_WORKERS 均分，合计不超过原额度）/ closed（直接拒绝）
RATE_LIMIT_CRITICAL_FALLBACK=strict
#   重任务并发名额：closed（停止接收新任务）/ local（各进程自己数）
CONCURRENCY_REDIS_DOWN=closed

JWT_SECRET_KEY=change-me-random-64-hex-or-long-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# 必须使用 Fernet key。生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=change-me-fernet-key

# 企业业务中心（Spring Boot，enterprise-business-hub/，Phase 5）。密钥生成同 JWT_SECRET_KEY
# （随机 64 位十六进制或更长），必须跟 enterprise-business-hub 部署时的
# ENTERPRISE_HUB_HMAC_SECRET 环境变量完全一致；生产环境不要用默认值。
ENTERPRISE_HUB_BASE_URL=http://127.0.0.1:8090
ENTERPRISE_HUB_HMAC_SECRET=change-me-random-64-hex-shared-with-enterprise-business-hub
ENTERPRISE_HUB_TIMEOUT_SECONDS=10
# enterprise-business-hub 自己的业务运行时账号（只读写 enterprise_business 库，
# 只有 DML 没有 DDL），建号脚本同样是 deploy/mysql-init/03-create-app-runtime-users.sh；
# Flyway 建表迁移单独用 MYSQL_ROOT_PASSWORD，见 docker-compose.prod.yml
# enterprise-hub 服务的 FLYWAY_DB_USER/FLYWAY_DB_PASSWORD。
ENTERPRISE_DB_USER=app_runtime_java
ENTERPRISE_DB_PASSWORD=change-me-strong-java-db-password

# 数据密级出口策略（第五轮审计 P0-1，service/data_egress_policy.py）：知识库空间
# 密级是 confidential 的内容，只有模型名在这个逗号分隔列表里才允许拼进发给该模型
# 的 system prompt；不设（默认空）等于任何模型都不批准，confidential 内容一律
# 拦掉。sensitivity=restricted 的内容不受这个白名单影响，任何情况下都拒绝外发
# （当前平台没有本地/离线模型选项，没有可以放这类内容的地方）。
# 例：CONFIDENTIAL_TIER_ALLOWED_MODELS=glm-4,glm-4-plus
CONFIDENTIAL_TIER_ALLOWED_MODELS=

EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=256
KNOWLEDGE_FILE_PATH=/app/knowledge_files

# 向量库。API 和 Worker 是两个独立进程：只要两者都在同一台机器/同一份数据上跑，
# 就必须用 Server 模式（设置 CHROMA_SERVER_HOST），不要只填 VECTOR_DB_PATH —
# ChromaDB 的内嵌 PersistentClient 不保证多进程并发读写安全。
# docker compose 已经内置了一个 chroma 服务，直接用下面两行即可；
# 非 Docker 部署需要自己起一个 `chroma run --path /data/chroma_db --port 8000`。
CHROMA_SERVER_HOST=chroma
CHROMA_SERVER_PORT=8000
# 未设置 CHROMA_SERVER_HOST 时才会退回内嵌模式，仅适合单进程/本地开发：
VECTOR_DB_PATH=/app/vector_db

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT=0.3
REDIS_SOCKET_TIMEOUT=0.5
REDIS_RECONNECT_INTERVAL_SECONDS=5

SMS_PROVIDER=aliyun
SMS_EXPOSE_DEV_CODE=0
ALIBABA_CLOUD_ACCESS_KEY_ID=change-me-ram-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=change-me-ram-access-key-secret
SMS_ALIYUN_SIGN_NAME=change-me-system-sign-name
SMS_ALIYUN_TEMPLATE_CODE=change-me-system-template-code
# For an existing webhook gateway instead, set SMS_PROVIDER=webhook and configure:
# SMS_WEBHOOK_URL=https://your-sms-gateway.example.com/send
# SMS_WEBHOOK_TOKEN=change-me-sms-webhook-token
SMS_WEBHOOK_TIMEOUT=3
SMS_CODE_TTL_SECONDS=300
SMS_CODE_SEND_INTERVAL_SECONDS=60
SMS_CODE_PHONE_LIMIT=1
SMS_CODE_PHONE_WINDOW_SECONDS=60
SMS_CODE_IP_LIMIT=20
SMS_CODE_IP_WINDOW_SECONDS=3600
SMS_CODE_DAILY_LIMIT=10
SMS_CODE_DAILY_WINDOW_SECONDS=86400
SMS_CODE_MAX_VERIFY_ATTEMPTS=5
# 全站短信总量封顶（防止换号码 / 换 IP 刷短信、刷爆费用；填 0 表示不限制）
SMS_CODE_GLOBAL_HOURLY_LIMIT=200
SMS_CODE_GLOBAL_DAILY_LIMIT=1000
# 同一手机号在窗口内最多校验多少次验证码（含错误尝试）
SMS_CODE_VERIFY_LIMIT=10
SMS_CODE_VERIFY_WINDOW_SECONDS=600
# 提交"重置密码"的频率（按 IP）
RESET_PASSWORD_RATE_LIMIT=10
RESET_PASSWORD_RATE_WINDOW_SECONDS=3600

HTTP_CLIENT_MAX_RETRIES=2
HTTP_CLIENT_RETRY_BASE_SECONDS=0.3
HTTP_CIRCUIT_FAILURE_THRESHOLD=5
HTTP_CIRCUIT_COOLDOWN_SECONDS=30
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_STREAM_TIMEOUT_SECONDS=60
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
USER_MAX_CONCURRENT_AGENT_RUNS=2
AGENT_RUN_CONCURRENCY_TTL_SECONDS=300

# Agent 企业接口连接器：URL/认证由用户预先配好，这里只限响应大小和超时，
# 防止一个配错/被劫持的企业接口把响应体喂爆模型上下文或把 Agent 运行拖住。
AGENT_API_CONNECTOR_TIMEOUT_SECONDS=10
AGENT_API_CONNECTOR_MAX_BYTES=262144
AGENT_API_CONNECTOR_MAX_RESPONSE_CHARS=4000

# 登录/注册防撞库：按来源 IP 和按用户名分别限流，5 分钟窗口内超限返回 429。
LOGIN_IP_RATE_LIMIT=20
LOGIN_USER_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT=10
REGISTER_RATE_WINDOW_SECONDS=3600

KNOWLEDGE_UPLOAD_RATE_LIMIT=10
KNOWLEDGE_UPLOAD_RATE_WINDOW_SECONDS=3600
KNOWLEDGE_REINDEX_RATE_LIMIT=10
KNOWLEDGE_REINDEX_RATE_WINDOW_SECONDS=3600
KNOWLEDGE_SEARCH_RATE_LIMIT=30
KNOWLEDGE_SEARCH_RATE_WINDOW_SECONDS=60
KNOWLEDGE_CRAWL_RATE_LIMIT=10
KNOWLEDGE_CRAWL_RATE_WINDOW_SECONDS=3600
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_BYTES=2097152
CRAWLER_MIN_TEXT_LENGTH=50
CRAWLER_USER_AGENT=AgentPlatformCrawler/1.0
CRAWLER_ALLOW_PRIVATE_NETWORK=0
CRAWLER_ALLOW_PRIVATE_DNS=0
CRAWLER_BROWSER_FALLBACK=0
CRAWLER_BROWSER_TIMEOUT_SECONDS=20
CRAWLER_BROWSER_WAIT_UNTIL=networkidle
USER_MAX_CONCURRENT_KNOWLEDGE_SEARCHES=3
KNOWLEDGE_SEARCH_CONCURRENCY_TTL_SECONDS=120
USER_MAX_ACTIVE_BACKGROUND_TASKS=5

TASK_EXECUTION_MODE=worker
TASK_WORKER_POLL_SECONDS=2
TASK_RUNNING_TIMEOUT_SECONDS=1800
TASK_MAX_AUTO_RETRIES=2
TASK_RETRY_BASE_SECONDS=30
TASK_RETRY_MAX_SECONDS=300

# 自定义工作台组件：到点自动调度（详见 docs/widget-platform.md）
WIDGET_SCHEDULER_ENABLED=1
WIDGET_SCHEDULER_POLL_SECONDS=60
WIDGET_SCHEDULER_LEASE_MINUTES=10
WIDGET_SCHEDULER_MAX_PER_TICK=50
# 失败退避 / 连续失败暂停
WIDGET_RETRY_BACKOFF_BASE_MINUTES=5
WIDGET_RETRY_BACKOFF_CAP_MINUTES=360
WIDGET_MAX_CONSECUTIVE_FAILS=6
# 数据点保留策略
WIDGET_KEEP_POINTS=200
WIDGET_KEEP_DAYS=90
WIDGET_KEEP_ERROR_POINTS=20
# 外部数据源限制
WIDGET_HTTP_TIMEOUT_SECONDS=10
WIDGET_HTTP_MAX_BYTES=1048576
WIDGET_WEBPAGE_MAX_CHARS=4000
# llm_summarize 喂给模型的数据最多截多少字符
WIDGET_SUMMARIZE_MAX_INPUT=6000

# 普通用户能否自己给 Agent 创建企业接口连接器（默认关闭）：单企业私有化部署下，接入外部
# 系统应由管理员统一审核配置，见 service/feature_flags.py
FEATURE_USER_API_CONNECTORS=false

# 脚本沙箱（默认关闭）：开启方法见 docker-compose.prod.yml 里 sandbox 服务的注释和 docs/deployment.md
SANDBOX_ENABLED=false
# 随机长字符串，api/worker 用它调用沙箱：python -c "import secrets; print(secrets.token_hex(32))"
SANDBOX_TOKEN=
SANDBOX_URL=http://sandbox-gw:8090
SANDBOX_TIMEOUT_SECONDS=30
# 用户上传附件和脚本生成文件的保留天数（放在 app_data 卷的 /app/data/attachments）
ATTACHMENT_TTL_DAYS=7
# 脚本沙箱的用户额度与权限：单个用户每个窗口内最多运行几次脚本；每人附件总量与文件数上限
SANDBOX_RATE_LIMIT=10
SANDBOX_RATE_WINDOW_SECONDS=60
ATTACHMENT_USER_MAX_MB=100
ATTACHMENT_USER_MAX_FILES=50
