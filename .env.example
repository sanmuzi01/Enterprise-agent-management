# 本地开发用配置模板 —— 复制成 .env 再填。生产部署见 .env.production.example / docs/deployment.md
# 只有 DB_* / JWT_SECRET_KEY / LLM_ENCRYPTION_KEY 是必填，其余留空走代码默认值。

APP_ENV=dev

# --- 数据库（必填）：本机 MySQL，先手动建一个空库 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agent_sql

# --- 密钥（必填）---
# JWT 签名密钥，随便一段长随机串： python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 加密用户填写的模型 API Key（Fernet）： python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=

# --- 管理员：用户名在这个列表里的账号自动是管理员 ---
ADMIN_USER_NAMES=admin

# --- 能力开关（单企业私有化部署默认收紧，见 service/feature_flags.py）---
# 普通用户能否自己给 Agent 创建企业接口连接器。默认关闭：接入外部系统应由管理员统一
# 审核配置。需要放开给普通用户自助配置（如个人 demo/评估环境）时设 true。
FEATURE_USER_API_CONNECTORS=false

# --- Redis：留空即可，缓存 / 限流 / 验证码会回退到进程内内存 ---
REDIS_URL=

# --- 文件与向量库路径（相对项目根目录）---
KNOWLEDGE_FILE_PATH=./knowledge_files
# 内嵌 ChromaDB，只适合本地这种单机场景。API（backend:dev）和 Worker（backend:worker）
# 是两个独立进程，理论上并发写同一份 sqlite 文件有小概率报 "database is locked"；
# 本地开发遇到了可以设 CHROMA_SERVER_HOST=127.0.0.1 + 起一个 `chroma run --port 8000`。
VECTOR_DB_PATH=./chroma_db

# --- 向量模型：默认用智谱 embedding-3；用户在「模型连接」里填 Key 后生效 ---
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024

# --- RAG 调优（可选，留空用默认）---
RAG_RERANK_ENABLED=0
RAG_MIN_SCORE=0.2
KB_STALE_DAYS=90

# --- 工作台组件调度：本地想试定时组件就设 1 ---
WIDGET_SCHEDULER_ENABLED=0

# --- 前端 dev server 代理 /api，通常不用改 ---
TRUSTED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- 企业业务中心（Spring Boot，enterprise-business-hub/，Phase 5）---
# HR Agent 的 OA 请假工具（service/tools/oa_leave.py）靠这两项签名调用；
# 密钥必须跟 enterprise-business-hub/src/main/resources/application.yml 里的
# enterprise-hub.security.hmac-secret 完全一致，两边各改一次，改了一边要同步另一边。
ENTERPRISE_HUB_BASE_URL=http://127.0.0.1:8090
ENTERPRISE_HUB_HMAC_SECRET=dev-only-shared-secret-change-me
ENTERPRISE_HUB_TIMEOUT_SECONDS=10

# --- 可观测性（都是可选的：不设置就不启用）---
# 设置后把链路和日志经 OTLP 发给 Collector（本地起栈：docker compose -f deploy/observability/docker-compose.yml up -d）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# OTEL_TRACE_SAMPLE_RATIO=1.0
# SENTRY_DSN=
# 设置后事件走 Kafka（不设置走数据库轮询）
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Prometheus 在容器里抓取宿主机后端时需要：TRUSTED_HOSTS=127.0.0.1,localhost,host.docker.internal

# --- 登录与上传（都有可用的默认值，需要时再改）---
# 登录令牌放在 HttpOnly Cookie 里；本地用 http 开发时保持默认（不带 Secure）。生产必须带 Secure。
# SESSION_COOKIE_SECURE=0
# SESSION_COOKIE_SAMESITE=lax
# 知识库上传大小上限：单个文件 / 一次请求累计 / 批量文件个数
# KNOWLEDGE_UPLOAD_MAX_BYTES=52428800
# KNOWLEDGE_UPLOAD_REQUEST_MAX_BYTES=209715200
# KNOWLEDGE_UPLOAD_MAX_FILES=20
